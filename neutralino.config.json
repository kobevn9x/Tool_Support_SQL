{
  "applicationId": "com.kobe.sqlformatter",
  "version": "1.1.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/sql-formatter.html",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "none",
  "logging": {
    "enabled": false
  },
  "nativeAllowList": [],
  "modes": {
    "window": {
      "title": "SQL Data Formatter",
      "width": 1400,
      "height": 1000,
      "minWidth": 1200,
      "minHeight": 800,
      "icon": "resources/icon.ico",
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "SQLDataFormatter",
    "resourcesPath": "/resources/",
    "binaryVersion": "6.7.0"
  }
}